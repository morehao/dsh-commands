{
  "name": "@morehao/dsh-commands",
  "version": "0.2.2",
  "description": "把 ai-kit 的 git-kit Git 工作流、handoff 跨会话交接与 disk-cleanup 磁盘清理以 dsh 原生斜杠命令接入（薄意图表，委托对应 skill 执行）",
  "icon": "icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "license": "MIT",
  "author": "morehao <morehao@qq.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/morehao/dsh-commands.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-command",
    "git",
    "git-kit",
    "handoff",
    "disk-cleanup",
    "cleanup",
    "conventional-commits",
    "skills"
  ],
  "dependencies": {
    "skills": "latest"
  },
  "engines": {
    "node": ">=22.20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "test": "node scripts/smoke-skill-setup.mjs && node scripts/smoke-skill-cache.mjs",
    "check": "node --check lib/client.js && node scripts/smoke-client-bundle.mjs && node scripts/check-naming.mjs && node scripts/check-pack.mjs && node scripts/smoke-skill-setup.mjs && node scripts/smoke-skill-cache.mjs"
  }
}
