{
  "name": "@morehao/dsh-commands",
  "version": "0.4.2",
  "description": "把 agent-skills 的 git-kit Git 工作流、handoff 跨会话交接与 disk-cleanup 磁盘清理以 dsh 原生斜杠命令接入（薄意图表，委托对应 skill 执行）",
  "icon": "icon.svg",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "license": "MIT",
  "author": "morehao <morehao@qq.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/morehao/dsh-commands.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-command",
    "git",
    "git-kit",
    "handoff",
    "disk-cleanup",
    "cleanup",
    "conventional-commits",
    "skills"
  ],
  "dependencies": {
    "@morehao/dsh-skills-console": ">=0.7.1 <0.8.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.20",
    "dsh": ">=0.2.1-rc.3 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.3 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.3 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node scripts/build-host.mjs",
    "dev": "node scripts/build-host.mjs --watch",
    "check:build": "node scripts/build-host.mjs --check",
    "check:artifact": "node scripts/check-artifact.mjs",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test": "npm run smoke:setup && npm run smoke:plan && npm run smoke:tool && npm run smoke:command && npm run smoke:plugin-update && npm run smoke:contract",
    "smoke:setup": "node scripts/smoke-skill-setup.mjs",
    "smoke:plan": "node scripts/smoke-skill-plan.mjs",
    "smoke:tool": "node scripts/smoke-skill-tool.mjs",
    "smoke:command": "node scripts/smoke-skill-command.mjs",
    "smoke:plugin-update": "node scripts/smoke-plugin-update.mjs",
    "smoke:contract": "node scripts/smoke-skill-contract.mjs",
    "check": "npm run check:syntax && npm run build && npm run check:artifact && npm run check:naming && npm run check:pack && npm run check:release-notes && npm test",
    "check:syntax": "node scripts/check-syntax.mjs",
    "check:naming": "node scripts/check-naming.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "check:release-notes": "node scripts/smoke-release-notes.mjs",
    "check:contract": "node scripts/check-skill-contract.mjs"
  }
}
